{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSV VT Scanner",
  "version": "1.0.0",
  "identifier": "com.darkgreen.csv-vt-scanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:local",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CSV VT Scanner — SOC Automation Hub",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
